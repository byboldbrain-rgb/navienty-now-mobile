{
  "expo": {
    "name": "Navienty Now",
    "slug": "navienty-now",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "navientynow",
    "userInterfaceStyle": "automatic",

    "ios": {
      "bundleIdentifier": "com.navienty.now",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.navienty.now",

      "icon": "./assets/images/icon.png",

      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "predictiveBackGestureEnabled": false,

      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00B14F",
          "image": "./assets/images/native-splash-transparent.png",
          "imageWidth": 1
        }
      ],

      "expo-web-browser",

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "اسمح لـ Navienty Now باستخدام موقعك لتحديد عنوان التوصيل تلقائيًا."
        }
      ],

      [
        "expo-notifications",
        {
          "defaultChannel": "orders"
        }
      ],

      "expo-secure-store",

      "expo-font"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},

      "eas": {
        "projectId": "32043d31-505f-44c7-8496-9bf8c32ba1e1"
      }
    },

    "owner": "navientynows-team"
  }
}